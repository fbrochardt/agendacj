# Copie para .env.local e preencha.

# Endereço público do app (sem barra no final). Em produção, use o domínio real.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase: Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Chave secreta (sb_secret_... ou a antiga service_role). Nunca exponha no navegador.
SUPABASE_SECRET_KEY=sb_secret_...

# Google Cloud Console → APIs e serviços → Credenciais → ID do cliente OAuth (Aplicativo da Web)
# URI de redirecionamento autorizado: {NEXT_PUBLIC_APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chave que criptografa as credenciais das agendas no banco. Gere com: openssl rand -base64 32
# Se trocar depois, todos precisarão reconectar as agendas.
ENCRYPTION_KEY=
